# Copy this file to  config.env  and fill in the real values.
# config.env is git-ignored on purpose - NEVER commit real credentials.
# The repo is public at submission, so a committed password is a public password.
DB=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTERADDRESS>/<DBNAME>?retryWrites=true&w=majority
# Required for register/login - any long random string. Without it, sign-up returns a 500.
JWT_SECRET=<LONG_RANDOM_STRING>
