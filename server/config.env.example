# TEMPLATE ONLY - the server never reads this file.
# Copy it to  server/config.env  (same folder) and fill in the real values:
#   Copy-Item server/config.env.example server/config.env
# config.env is git-ignored on purpose - NEVER commit real credentials.
# The repo is public at submission, so a committed password is a public password.

# MongoDB Atlas connection string. Leave empty to run in mock mode (data/places.json).
DB=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTERADDRESS>/<DBNAME>?retryWrites=true&w=majority

# Required for register/login - any long random string.
JWT_SECRET=<LONG_RANDOM_STRING>

# Google Gemini key for the AI study assistant (https://aistudio.google.com/apikey).
# Without it the assistant replies that it is not set up.
GEMINI_API_KEY=<GEMINI_API_KEY>

# OneMap account for map directions (register at https://www.onemap.gov.sg/apidocs/register).
# The server uses these to get a fresh access token by itself whenever the old one
# (valid 3 days) is about to expire. Finding a place on the map needs no key at all.
ONEMAP_EMAIL=<ONEMAP_ACCOUNT_EMAIL>
ONEMAP_PASSWORD=<ONEMAP_ACCOUNT_PASSWORD>

# Optional fallback: a fixed token, used only when the email/password above are empty.
# It stops working after 3 days, so prefer the account details.
ONEMAP_TOKEN=

# Optional: NLB API credentials for library photos/details.
NLB_API_KEY=
NLB_API_CODE=
